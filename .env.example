# TCP Server Port for Devices (default: 8000)
TCP_PORT=8000

# HTTP REST API & Socket.IO Port (default: 8001)
HTTP_PORT=8001

# Server Host (default: 0.0.0.0)
HOST=0.0.0.0

# Inactivity timeout in ms (default: 1200000 = 20 minutes, 0 = disabled)
INACTIVITY_TIMEOUT_MS=1200000

# Hex length formatting (0 = Uppercase e.g. 0002, 1 = Lowercase)
LEN_LOWERCASE=0

# Security: API Key required for HTTP endpoints (x-api-key header) and Socket.IO connection
API_SECRET_KEY=change_me_to_a_secure_token

# CORS: Allowed origins (* for all, or comma-separated list of allowed URLs)
# Example: CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://myfrontend.com
CORS_ORIGIN=*
